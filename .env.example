# Epilepscreen local development
# Copy to .env. Replace the Django key with a unique value for your machine.
# Existing environment variables take precedence over values in .env.

# Django
DJANGO_SECRET_KEY=replace-with-a-generated-key
DJANGO_DEBUG=1

# Database
# SQLite stores data in db.sqlite3 alongside manage.py.
DB_ENGINE=sqlite
# For MySQL, set DB_ENGINE=mysql, install mysqlclient, and provide an existing
# database and a user with access to it.
# DB_NAME=epilepscreen
# DB_USER=epilepscreen
# DB_PASSWORD=
# DB_HOST=127.0.0.1
# DB_PORT=3306

# Media screening
# Maximum size of a single upload, in bytes (104857600 = 100 MiB).
MAX_UPLOAD_BYTES=104857600
# 0 checks every decoded frame. A positive target FPS enables subsampling and
# can miss short or repeating flashes.
ANALYSIS_FPS=0
